# ─── OpenRouter (powers the Fint Hjem estimator assistant) ────────────────
#
# Copy this file to `.env.local` and fill in the values. On the hosting
# platform (Vercel / Netlify / etc.) set the same keys in the project's
# environment variables — do NOT commit .env.local.
#
# 1. Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 2. Optional. The model slug OpenRouter should route to.
#    - Vision-capable (recommended): anthropic/claude-3.5-sonnet, openai/gpt-4o,
#      google/gemini-pro-1.5, mistralai/pixtral-12b
#    - Text-only (cheaper): meta-llama/llama-3.1-70b-instruct
#    Default if unset: anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 3. Optional — surfaces the app in OpenRouter's rankings and usage dashboard.
OPENROUTER_SITE_URL=https://finthjem.no
OPENROUTER_APP_NAME=Fint Hjem Estimator
